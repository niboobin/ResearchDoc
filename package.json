{
  "name": "researchdoc",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "node node_modules/@tailwindcss/cli/dist/index.mjs -i ./static/src/input.css -o ./static/css/output.css",
    "watch:css": "node node_modules/@tailwindcss/cli/dist/index.mjs -i ./static/src/input.css -o ./static/css/output.css --watch",
    "build:js": "esbuild static/src/editor.js --bundle --minify --format=iife --outfile=static/js/editor.js",
    "watch:js": "esbuild static/src/editor.js --bundle --format=iife --outfile=static/js/editor.js --watch",
    "build": "npm run build:css && npm run build:js"
  },
