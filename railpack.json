{
  "$schema": "https://schema.railpack.com",
  "providers": ["python", "node"],
  "steps": {
    "build": {
      "commands": [
        "npm install",
        "npm run build",
        "python manage.py collectstatic --noinput -i src"
      ]
    }
  },
  "deploy": {
    "startCommand": "gunicorn researchdoc.wsgi --log-file - --workers 2 --timeout 60"
  }
}
